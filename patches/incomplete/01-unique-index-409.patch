diff --git a/src/main/resources/db/migration/V2__orders_idempotency_key_unique.sql b/src/main/resources/db/migration/V2__orders_idempotency_key_unique.sql
new file mode 100644
index 0000000..4d110fb
--- /dev/null
+++ b/src/main/resources/db/migration/V2__orders_idempotency_key_unique.sql
@@ -0,0 +1,5 @@
+-- One order per idempotency key, enforced by the database. The application
+-- check in OrderService was a find-then-insert and lost the race under
+-- concurrent retries (ORD-2291).
+DROP INDEX IF EXISTS idx_orders_idempotency_key;
+CREATE UNIQUE INDEX uq_orders_idempotency_key ON orders (idempotency_key);
